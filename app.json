{
  "expo": {
    "name": "Zikrukum",
    "slug": "zikrukum",
    "scheme": "zikrukum",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EEE0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.azkar.zikrukum",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/adaptive-foreground.png",
        "backgroundColor": "#F4EEE0"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": ["arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d59c07b9-6625-49d8-b7d6-9d2437abd33b"
      }
    }
  }
}

{
  "expo": {
    "name": "Zikrukum",
    "slug": "zikrukum",
    "scheme": "zikrukum",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EEE0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.azkar.zikrukum",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/adaptive-foreground.png",
        "backgroundColor": "#F4EEE0"
      }
    },
    "plugins": [
      "expo-font",
      "expo-audio"
    ]
  }
}
